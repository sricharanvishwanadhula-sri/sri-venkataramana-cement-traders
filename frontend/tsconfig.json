{
  "compilerOptions": {
    "target": "ES2020", "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext", "moduleResolution": "node", "jsx": "react-jsx",
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "baseUrl": "src", "paths": {"@/*": ["*"]}
  },
  "include": ["src"]
}